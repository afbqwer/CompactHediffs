<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<AssemblyName>PeteTimesSix.CompactHediffs</AssemblyName>
		<RootNamespace>PeteTimesSix.CompactHediffs</RootNamespace>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
		<GenerateDependencyFile>false</GenerateDependencyFile>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<DebugType>none</DebugType>
		<Deterministic>true</Deterministic>
		<OutputPath>..\Assemblies\</OutputPath>
		<IntermediateOutputPath>obj\$(Configuration)\</IntermediateOutputPath>
		<!-- 禁止 SDK 隐式引用整套 BCL 之外的东西；net10.0 直接引用游戏根目录程序集 -->
		<ImplicitUsings>disable</ImplicitUsings>
		<EnableDefaultCompileItems>true</EnableDefaultCompileItems>
	</PropertyGroup>

	<!--
		游戏目录定位：工程位于 <游戏>\Mods\<模组>\Source\，向上三级即游戏根目录。
		如需覆盖（游戏装在别处/工程挪了位置），设环境变量 RIMWORLD_DIR 或
		dotnet build -p:RimWorldDir="D:\path\to\RimWorld\"。
	-->
	<PropertyGroup>
		<RimWorldDir Condition="'$(RimWorldDir)' == ''">$(RIMWORLD_DIR)</RimWorldDir>
		<RimWorldDir Condition="'$(RimWorldDir)' == ''">$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '..', '..', '..'))</RimWorldDir>
	</PropertyGroup>

	<ItemGroup>
		<Reference Include="Assembly-CSharp">
			<HintPath>$(RimWorldDir)Assembly-CSharp.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="UnityStubs">
			<HintPath>$(RimWorldDir)UnityStubs.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="Waylith">
			<HintPath>$(RimWorldDir)Waylith.dll</HintPath>
			<Private>false</Private>
		</Reference>
	</ItemGroup>

	<ItemGroup>
		<!-- 1.7 运行时由 Workshop 的 brrainz.harmony 提供 0Harmony 3.0.0.0 -->
		<PackageReference Include="Lib.Harmony">
			<Version>3.0.0-rc.2</Version>
			<ExcludeAssets>runtime</ExcludeAssets>
		</PackageReference>
	</ItemGroup>

	<!-- 游戏程序集找不到时立刻报错，而不是等到运行时 Could not load assembly -->
	<Target Name="VerifyRimWorldReferences" BeforeTargets="ResolveReferences">
		<Error Condition="!Exists('$(RimWorldDir)Assembly-CSharp.dll')"
		       Text="找不到 $(RimWorldDir)Assembly-CSharp.dll。请确认 RimWorldDir 指向 1.7 游戏根目录（当前解析为 '$(RimWorldDir)'）。" />
		<Error Condition="!Exists('$(RimWorldDir)UnityStubs.dll')"
		       Text="找不到 $(RimWorldDir)UnityStubs.dll。1.7 的 Unity 适配层必须在游戏根目录（当前解析为 '$(RimWorldDir)'）。" />
	</Target>

</Project>
